<%- include('partials/header') %>
<div class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-extrabold text-white">Register Vehicle Spec Sheet</h1>
        <p class="text-gray-400 text-sm mt-1">Insert high-spec asset telemetry into Supabase</p>
    </div>

    <form action="/inventory/add" method="POST" class="bg-gray-900 border border-gray-800 p-6 rounded-xl space-y-6">
        
        <!-- General Info -->
        <div>
            <h2 class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-3">01. Identity & Pricing</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Make</label>
                    <input type="text" name="make" placeholder="e.g. Porsche" required class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Model</label>
                    <input type="text" name="model" placeholder="e.g. GT3 RS" required class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Year</label>
                    <input type="number" name="year" placeholder="2024" required class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Price ($)</label>
                    <input type="number" step="0.01" name="price" placeholder="225000" required class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
            </div>
        </div>

        <!-- Technical Telemetry -->
        <div>
            <h2 class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-3">02. Mechanical Specs & Chassis</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">VIN / Chassis No.</label>
                    <input type="text" name="vin" placeholder="17-Digit VIN / Chassis Number" class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500 uppercase font-mono">
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Engine Spec</label>
                    <input type="text" name="engine_type" placeholder="e.g. 4.0L Flat-6 NA / V8 Twin-Turbo" class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Fuel Type</label>
                    <select name="fuel_type" class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                        <option value="Petrol">Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Electric">EV / Electric</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Transmission</label>
                    <select name="transmission" class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                        <option value="Manual">Manual</option>
                        <option value="Automatic">Automatic</option>
                        <option value="Dual-Clutch (PDK/DCT)">Dual-Clutch (PDK/DCT)</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs uppercase text-gray-400 font-semibold mb-1">Mileage (km / mi)</label>
                    <input type="float" name="mileage" placeholder="e.g. 12500" class="w-full bg-gray-950 border border-gray-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
            </div>
        </div>

        <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-gray-950 font-bold py-2.5 px-4 rounded transition">
            ⚡ Save Complete Vehicle Profile
        </button>
    </form>
</div>
<%- include('partials/footer') %>